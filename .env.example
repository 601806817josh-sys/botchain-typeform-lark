APP_ENV=development
LOG_LEVEL=INFO
SQLITE_PATH=data/typeform_lark.sqlite3

TYPEFORM_FORM_ID=replace-with-your-form-id
TYPEFORM_WEBHOOK_SECRET=replace-with-a-random-secret

LARK_APP_ID=replace-with-your-app-id
LARK_APP_SECRET=replace-with-your-app-secret
LARK_BASE_TOKEN=replace-with-your-base-token
LARK_MASTER_TABLE_ID=replace-with-your-master-table-id
LARK_ECOSYSTEM_TABLE_ID=replace-with-your-ecosystem-table-id
LARK_GAS_TABLE_ID=replace-with-your-gas-table-id
LARK_EVENT_TABLE_ID=replace-with-your-event-table-id
LARK_INCUBATION_TABLE_ID=replace-with-your-incubation-table-id

# The Lark group that receives new-application notifications.
LARK_NOTIFICATIONS_ENABLED=false
LARK_NOTIFICATION_CHAT_ID=
# Lark open_id values used for real @ mentions and People fields.
LARK_OWNER_EVAN_OPEN_ID=
LARK_OWNER_CHRIS_OPEN_ID=
LARK_OWNER_MOSES_OPEN_ID=

DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
